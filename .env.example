# ===========================================
# Ham Radio Study - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ===========================================
# Feature Flags (build time)
# ===========================================
# Gamification: XP, levels, achievements, daily goals, streak calendar.
# Disabled unless set to exactly "true". Read at BUILD time and inlined into
# the bundle, so changing it requires a rebuild — restarting is not enough.
# Saved XP/achievements in localStorage are untouched while it is off.
# NEXT_PUBLIC_GAMIFICATION=true

# ===========================================
# Exam Submission (Resend Email)
# ===========================================
# Get your API key from https://resend.com/api-keys
# Free tier: 3000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address where exam submissions will be sent
EXAM_SUBMISSION_EMAIL=your-email@example.com

# Sender email address (must be verified in Resend)
# Use "onboarding@resend.dev" for testing, or your own verified domain
RESEND_FROM_EMAIL=onboarding@resend.dev

# ===========================================
# Remote Deployment (deploy-remote.sh)
# ===========================================
DEPLOY_REMOTE_USER=your-user
DEPLOY_REMOTE_HOST=your-host-or-ip
# DEPLOY_REMOTE_DIR=~/containers/radioescola
# DEPLOY_APP_NAME=radioescola
